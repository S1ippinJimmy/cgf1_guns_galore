<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingDef Name="CGF1_RocketMoteBase" Abstract="True">
		<thingClass>MoteThrown</thingClass>
		<category>Mote</category>

		<graphicData>
			<graphicClass>Graphic_Mote</graphicClass>
			<shaderType>Mote</shaderType>
		</graphicData>

		<altitudeLayer>MoteOverhead</altitudeLayer>
		<tickerType>Normal</tickerType>
		<useHitPoints>false</useHitPoints>
		<isSaveable>false</isSaveable>
		<rotatable>false</rotatable>
	</ThingDef>
	
	<ThingDef ParentName="CGF1_RocketMoteBase">
		<defName>CGF1_Mote_RocketSmoke</defName>
		<label>rocket smoke</label>

		<graphicData>
			<texPath>CGF1/Gas/Smoke</texPath>
			<graphicClass>Graphic_Mote</graphicClass>
			<shaderType>Mote</shaderType>
			<drawSize>(0.8,0.8)</drawSize>
			<color>(0.8,0.8,0.8,1)</color>
		</graphicData>

		<mote>
			<fadeInTime>0.05</fadeInTime>
			<solidTime>0.1</solidTime>
			<fadeOutTime>1.5</fadeOutTime>
			<growthRate>0.45</growthRate>
		</mote>
	</ThingDef>
	
	<ThingDef ParentName="CGF1_RocketMoteBase">
		<defName>CGF1_Mote_RocketFlame</defName>
		<label>rocket flame</label>

		<graphicData>
			<texPath>Things/Mote/FireGlow</texPath>
			<graphicClass>Graphic_Mote</graphicClass>
			<shaderType>MoteGlow</shaderType>
			<drawSize>(0.5,0.5)</drawSize>
		</graphicData>

		<mote>
			<fadeInTime>0</fadeInTime>
			<solidTime>0.02</solidTime>
			<fadeOutTime>0.08</fadeOutTime>
			<growthRate>-1</growthRate>
		</mote>
	</ThingDef>
	
	<ThingDef ParentName="CGF1_RocketMoteBase">
		<defName>CGF1_Mote_Tracer</defName>
		<label>bullet tracer</label>

		<graphicData>
			<texPath>CGF1/Projectile/BasicBullet_Tracer</texPath>
			<graphicClass>Graphic_Mote</graphicClass>
			<shaderType>MoteGlow</shaderType>
			<drawSize>(0.4,0.4)</drawSize>
		</graphicData>

		<mote>
			<fadeInTime>0</fadeInTime>
			<solidTime>0.02</solidTime>
			<fadeOutTime>1.5</fadeOutTime>
			<growthRate>-1</growthRate>
		</mote>
	</ThingDef>
	
</Defs>